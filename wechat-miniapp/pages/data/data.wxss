.container { padding: 16px; background: #f5f7fa; min-height: 100vh; }
.card { background: #fff; border-radius: 14px; padding: 20px; margin-bottom: 16px; }
.card-title { font-size: 16px; font-weight: 600; color: #333; margin-bottom: 14px; }
.hr-row { display: flex; gap: 12px; }
.hr-item { flex: 1; text-align: center; }
.hr-label { font-size: 12px; color: #999; display: block; margin-bottom: 4px; }
.hr-value { font-size: 24px; font-weight: 700; color: #333; }
.hr-value.primary { color: #2d6cdf; }
.chart { width: 100%; height: 180px; border-radius: 8px; background: #fafbfc; }
.bar-row { height: 80px; display: flex; align-items: flex-end; padding: 4px 0; border-bottom: 1px solid #eee; }
.bar { border-radius: 2px 2px 0 0; min-width: 2px; flex-shrink: 1; }
