<view class="container">
  <view class="card">
    <view class="card-title">❤ 心率详情</view>
    <view class="hr-row">
      <view class="hr-item">
        <text class="hr-label">当前</text>
        <text class="hr-value primary">{{heartRate}} bpm</text>
      </view>
      <view class="hr-item">
        <text class="hr-label">平均</text>
        <text class="hr-value">{{hrSummary.avg}}</text>
      </view>
      <view class="hr-item">
        <text class="hr-label">最高/最低</text>
        <text class="hr-value">{{hrSummary.max}}/{{hrSummary.min}}</text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">🏃 活动统计</view>
    <view class="env-row">
      <view class="card-half">
        <view class="card-value-sm">{{actSummary.total}}</view>
        <view class="card-label-sm">今日活动次数</view>
      </view>
      <view class="card-half">
        <view class="card-value-sm">{{actSummary.perHour}}次/时</view>
        <view class="card-label-sm">平均每小时</view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">🌡 温湿度趋势 (近10次)</view>
    <view class="trend-row">
      <block wx:for="{{tempHistory}}" wx:key="t">
        <view class="trend-dot" style="height:{{item.v}}px; background: #ff6b6b;"></view>
      </block>
    </view>
    <view class="trend-row">
      <block wx:for="{{humHistory}}" wx:key="t">
        <view class="trend-dot" style="height:{{item.v*0.3}}px; background: #4ecdc4;"></view>
      </block>
    </view>
  </view>

  <view class="card">
    <view class="card-title">📈 心率趋势 (近10次)</view>
    <view class="trend-row">
      <block wx:for="{{hrHistory}}" wx:key="t">
        <view class="trend-dot" style="height:{{item.v-40}}px; background: #a29bfe;"></view>
      </block>
    </view>
  </view>
</view>
