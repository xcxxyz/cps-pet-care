<view class="container">
  <view class="card">
    <view class="card-title">❤ 心率详情</view>
    <view class="hr-row">
      <view class="hr-item">
        <text class="hr-label">当前</text>
        <text class="hr-value primary">{{heartRate}} bpm</text>
      </view>
      <view class="hr-item">
        <text class="hr-label">平均</text>
        <text class="hr-value">{{hrSummary.avg}}</text>
      </view>
      <view class="hr-item">
        <text class="hr-label">最高/最低</text>
        <text class="hr-value">{{hrSummary.max}}/{{hrSummary.min}}</text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">🏃 今日活动次数</view>
    <view class="big-num">{{activityToday}}</view>
  </view>

  <view class="card">
    <view class="card-title">📈 实时趋势（温度/湿度/心率）</view>
    <view class="legend">
      <text class="leg-dot" style="background:#ff6b6b"></text><text>温度</text>
      <text class="leg-dot" style="background:#4ecdc4"></text><text>湿度</text>
      <text class="leg-dot" style="background:#a29bfe"></text><text>心率</text>
    </view>
    <canvas type="2d" id="chart" class="chart"></canvas>
  </view>
</view>
