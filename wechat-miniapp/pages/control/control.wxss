.container { padding: 16px; background: #f5f7fa; min-height: 100vh; }
.card { background: #fff; border-radius: 14px; padding: 20px; margin-bottom: 16px; }
.card-title { font-size: 16px; font-weight: 600; color: #333; margin-bottom: 14px; }
.feed-btn { width: 100%; background: #f59e0b; color: #fff; border-radius: 12px; height: 48px; line-height: 48px; font-size: 18px; font-weight: 600; margin-bottom: 10px; }
.feed-info { font-size: 13px; color: #999; text-align: center; }
.led-display { display: flex; align-items: center; gap: 16px; margin-bottom: 16px; }
.led-circle { width: 40px; height: 40px; border-radius: 50%; background: #ddd; transition: all 0.2s; }
.led-circle.on { background: #fbbf24; box-shadow: 0 0 20px #fbbf24; }
.led-value { font-size: 28px; font-weight: 700; color: #333; }
.quick-btns { display: flex; gap: 8px; margin-top: 12px; }
.qbtn { flex: 1; font-size: 12px; padding: 6px 0; border-radius: 8px; background: #f0f2f5; color: #666; }
.mode-tag { font-size: 12px; padding: 2px 10px; border-radius: 10px; margin-left: auto; }
.mode-tag.auto { background: #d1fae5; color: #065f46; }
.mode-tag.manual { background: #fef3c7; color: #92400e; }
.auto-btn { width: 100%; margin-top: 12px; height: 40px; line-height: 40px; border-radius: 10px; background: #f0f2f5; color: #666; font-size: 14px; }
.auto-btn.active { background: #d1fae5; color: #065f46; font-weight: 600; }
